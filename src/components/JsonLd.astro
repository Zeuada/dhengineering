---
import { company, iso, products } from '@/data/site';

interface Props {
  type?: 'home' | 'page' | 'products';
  breadcrumbs?: { name: string; href: string }[];
}
const { type = 'page', breadcrumbs } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';

const organization = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness', 'Manufacturer'],
  '@id': `${site}/#organization`,
  name: company.name,
  alternateName: 'DH Engineering Kolhapur',
  url: `${site}/`,
  email: company.email,
  description: company.shortDesc,
  foundingDate: String(company.founded),
  slogan: company.legalTagline,
  logo: `${site}/favicon-512.png`,
  image: `${site}/og-default.jpg`,
  telephone: company.contacts[0].tel,
  vatID: company.gst,
  taxID: company.gst,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${company.address.line1}, ${company.address.line2}`,
    addressLocality: company.address.city,
    addressRegion: company.address.state,
    postalCode: company.address.postalCode,
    addressCountry: 'IN',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: company.address.geo.lat,
    longitude: company.address.geo.lng,
  },
  contactPoint: company.contacts.map((c) => ({
    '@type': 'ContactPoint',
    telephone: c.tel,
    contactType: 'sales',
    name: c.name,
    areaServed: 'IN',
    availableLanguage: ['en', 'hi', 'mr'],
  })),
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'certification',
    name: iso.fullStandard,
    identifier: iso.certNo,
    recognizedBy: { '@type': 'Organization', name: iso.issuedBy },
  },
  knowsAbout: [
    'Aluminium high pressure die casting',
    'CNC machining',
    'VMC machining',
    'Aluminium machined components',
  ],
};

const productList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.title,
      description: p.body,
      category: 'Aluminium die-cast & machined component',
      brand: { '@type': 'Brand', name: company.name },
      manufacturer: { '@id': `${site}/#organization` },
    },
  })),
};

const breadcrumbList = breadcrumbs && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: `${site}${b.href}`,
  })),
};

const blocks = [organization];
if (type === 'products') blocks.push(productList as any);
if (breadcrumbList) blocks.push(breadcrumbList as any);
---
{blocks.map((b) => (
  <script type="application/ld+json" set:html={JSON.stringify(b)} />
))}
