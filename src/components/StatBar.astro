---
import { stats } from '@/data/site';
interface Props { variant?: 'light' | 'dark'; }
const { variant = 'dark' } = Astro.props;
---
<section class={`statbar statbar--${variant}`} aria-label="Company at a glance">
  <div class="container statbar__grid">
    {stats.map((s) => (
      <div class="statbar__item">
        <span class="statbar__value">{s.value}</span>
        <span class="statbar__label">{s.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .statbar--dark { background: var(--ink); color: #fff; }
  .statbar--light { background: var(--white); border-block: 1px solid var(--line); }
  .statbar__grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    padding-block: 2.2rem; gap: 1rem; text-align: center;
  }
  .statbar__item { padding-inline: .5rem; position: relative; }
  .statbar__item + .statbar__item::before {
    content: ''; position: absolute; left: 0; top: 12%; height: 76%; width: 1px;
    background: rgba(255,255,255,.16);
  }
  .statbar--light .statbar__item + .statbar__item::before { background: var(--line); }
  .statbar__value {
    display: block; font-family: var(--font-head); font-weight: 700;
    font-size: clamp(1.5rem, 3.2vw, 2.3rem); color: #fff; line-height: 1.1;
  }
  .statbar--light .statbar__value { color: var(--ink); }
  .statbar__label {
    display: block; margin-top: .35rem; font-size: .82rem; letter-spacing: .04em;
    text-transform: uppercase; color: var(--on-dark-muted);
  }
  .statbar--light .statbar__label { color: var(--muted); }
  @media (max-width: 620px) {
    .statbar__grid { grid-template-columns: repeat(2, 1fr); gap: 1.6rem 1rem; }
    .statbar__item:nth-child(3)::before, .statbar__item:nth-child(odd)::before { display: none; }
  }
</style>
