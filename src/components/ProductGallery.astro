---
import { Image } from 'astro:assets';
import { gallery } from '@/data/site';

// Resolve all product images at build time.
const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/product-*.{jpg,jpeg,png}',
  { eager: true }
);
const resolve = (name: string) => files[`/src/assets/images/${name}`]?.default;
const items = gallery
  .map((g) => ({ ...g, img: resolve(g.image) }))
  .filter((g) => g.img);
---
<div class="gallery" id="gallery">
  {items.map((item, i) => (
    <figure class="gallery__item">
      <button class="gallery__btn" data-index={i} aria-label={`View larger: ${item.alt}`}>
        <Image
          src={item.img!}
          alt={item.alt}
          widths={[300, 500, 700]}
          sizes="(max-width: 600px) 45vw, (max-width: 900px) 30vw, 260px"
          loading={i < 4 ? 'eager' : 'lazy'}
        />
        <span class="gallery__zoom" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3M11 8v6M8 11h6"/></svg>
        </span>
      </button>
    </figure>
  ))}
</div>

<dialog class="lightbox" id="lightbox" aria-label="Product image viewer">
  <button class="lightbox__close" aria-label="Close">&times;</button>
  <button class="lightbox__nav lightbox__prev" aria-label="Previous image">&#8249;</button>
  <img class="lightbox__img" src="" alt="" />
  <button class="lightbox__nav lightbox__next" aria-label="Next image">&#8250;</button>
  <p class="lightbox__caption" aria-live="polite"></p>
</dialog>

<script>
  const data = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery__btn')).map((b) => {
    const img = b.querySelector('img')!;
    return { src: img.currentSrc || img.src, alt: img.alt };
  });
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  const dimg = dlg?.querySelector<HTMLImageElement>('.lightbox__img');
  const cap = dlg?.querySelector<HTMLParagraphElement>('.lightbox__caption');
  let idx = 0;

  function show(i: number) {
    if (!dlg || !dimg || !cap) return;
    idx = (i + data.length) % data.length;
    dimg.src = data[idx].src;
    dimg.alt = data[idx].alt;
    cap.textContent = data[idx].alt;
  }
  document.querySelectorAll<HTMLButtonElement>('.gallery__btn').forEach((b) => {
    b.addEventListener('click', () => {
      show(Number(b.dataset.index));
      dlg?.showModal();
    });
  });
  dlg?.querySelector('.lightbox__close')?.addEventListener('click', () => dlg.close());
  dlg?.querySelector('.lightbox__next')?.addEventListener('click', () => show(idx + 1));
  dlg?.querySelector('.lightbox__prev')?.addEventListener('click', () => show(idx - 1));
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  document.addEventListener('keydown', (e) => {
    if (!dlg?.open) return;
    if (e.key === 'ArrowRight') show(idx + 1);
    if (e.key === 'ArrowLeft') show(idx - 1);
  });
</script>

<style>
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1rem; }
  .gallery__item { margin: 0; }
  .gallery__btn {
    position: relative; display: block; width: 100%; padding: 0; cursor: pointer;
    border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden;
    background: #0c1623; aspect-ratio: 1 / 1;
  }
  .gallery__btn img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .gallery__btn:hover img { transform: scale(1.05); }
  .gallery__zoom {
    position: absolute; right: 8px; bottom: 8px; width: 34px; height: 34px;
    display: grid; place-items: center; border-radius: 8px;
    background: rgba(15,34,56,.78); color: #fff; opacity: 0; transition: opacity .2s ease;
  }
  .gallery__btn:hover .gallery__zoom, .gallery__btn:focus-visible .gallery__zoom { opacity: 1; }

  .lightbox {
    border: 0; padding: 0; margin: 0; background: transparent;
    width: 100vw; height: 100vh; max-width: 100vw; max-height: 100vh;
    inset: 0; overflow: hidden;
  }
  .lightbox[open] {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
  }
  .lightbox::backdrop { background: rgba(8,16,28,.9); backdrop-filter: blur(3px); }
  .lightbox__img {
    max-width: 90vw; max-height: 82vh; border-radius: 8px; margin-inline: auto;
    box-shadow: 0 20px 60px rgba(0,0,0,.5); background: #0c1623;
  }
  .lightbox__caption { color: #e8edf3; text-align: center; margin-top: .8rem; font-size: .95rem; }
  .lightbox__close, .lightbox__nav {
    position: fixed; background: rgba(255,255,255,.12); color: #fff; border: 0;
    width: 48px; height: 48px; border-radius: 50%; font-size: 1.8rem; cursor: pointer;
    display: grid; place-items: center; line-height: 1;
  }
  .lightbox__close:hover, .lightbox__nav:hover { background: rgba(255,255,255,.25); }
  .lightbox__close { top: 18px; right: 18px; }
  .lightbox__prev { left: 14px; top: 50%; transform: translateY(-50%); }
  .lightbox__next { right: 14px; top: 50%; transform: translateY(-50%); }
</style>
