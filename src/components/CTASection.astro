---
import { company } from '@/data/site';
interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = 'Have a Component to Cast or Machine?',
  body = "Send us your drawing and we'll get back to you with feasibility and a quote.",
} = Astro.props;
const waHref = `https://wa.me/${company.whatsapp.number}?text=${encodeURIComponent(company.whatsapp.prefill)}`;
---
<section class="cta">
  <div class="container cta__inner">
    <div class="cta__text">
      <h2>{heading}</h2>
      <p>{body}</p>
    </div>
    <div class="btn-row cta__actions">
      <a class="btn btn--accent" href="/contact/">Request a Quote</a>
      <a class="btn btn--whatsapp" href={waHref} target="_blank" rel="noopener">Chat on WhatsApp</a>
    </div>
  </div>
</section>

<style>
  .cta { background:
      linear-gradient(180deg, var(--ink) 0%, var(--ink-900) 100%);
    color: #fff; }
  .cta__inner {
    display: flex; align-items: center; justify-content: space-between; gap: 2rem;
    padding-block: clamp(2.6rem, 5vw, 3.6rem); flex-wrap: wrap;
  }
  .cta__text { max-width: 60ch; }
  .cta h2 { color: #fff; margin-bottom: .5rem; }
  .cta p { color: var(--on-dark-muted); }
  .cta__actions { flex-shrink: 0; }
  @media (max-width: 720px) { .cta__actions .btn { flex: 1; } }
</style>
