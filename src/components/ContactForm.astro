---
import { formAccessKey } from '@/data/site';
---
<form class="qform" id="quote-form" action="https://formly.email/submit" method="POST"
      enctype="multipart/form-data">
  <!-- formly.email config -->
  <input type="hidden" name="access_key" value={formAccessKey} />
  <input type="hidden" name="subject" value="New quote request — DH Engineering website" />
  <input type="hidden" name="from_name" value="DH Engineering Website" />
  <!-- honeypot (bots fill this; humans never see it) -->
  <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="qform__grid">
    <div class="field">
      <label for="f-name">Name <span aria-hidden="true">*</span></label>
      <input id="f-name" name="name" type="text" required autocomplete="name" />
    </div>
    <div class="field">
      <label for="f-company">Company Name</label>
      <input id="f-company" name="company" type="text" autocomplete="organization" />
    </div>
    <div class="field">
      <label for="f-email">Email <span aria-hidden="true">*</span></label>
      <input id="f-email" name="email" type="email" required autocomplete="email" />
    </div>
    <div class="field">
      <label for="f-phone">Phone</label>
      <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
    </div>
  </div>

  <div class="field">
    <label for="f-file">Component / Drawing (optional)</label>
    <input id="f-file" name="attachment" type="file"
           accept=".pdf,.dwg,.dxf,.step,.stp,.igs,.iges,.png,.jpg,.jpeg,.zip" />
    <small class="hint">PDF, DWG, DXF, STEP/IGES or image. Max ~10 MB. No drawing yet? Just describe your part below.</small>
  </div>

  <div class="field">
    <label for="f-message">Message / Requirement <span aria-hidden="true">*</span></label>
    <textarea id="f-message" name="message" rows="5" required
      placeholder="Part description, material/grade, quantity, target tolerances, annual volume…"></textarea>
  </div>

  <div class="qform__actions">
    <button type="submit" class="btn btn--accent">Send Enquiry</button>
    <p class="qform__status" id="form-status" role="status" aria-live="polite"></p>
  </div>
</form>

<style>
  .qform { display: grid; gap: 1.2rem; }
  .qform__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .field { display: flex; flex-direction: column; gap: .4rem; }
  .field label { font-family: var(--font-head); font-weight: 600; font-size: .92rem; color: var(--ink); }
  .field label span { color: var(--accent-700); }
  .field input, .field textarea {
    font: inherit; color: var(--text); background: #fff;
    border: 1.5px solid var(--line-strong); border-radius: var(--radius-sm); padding: .7em .85em;
    width: 100%; transition: border-color .15s ease;
  }
  .field input:focus, .field textarea:focus { border-color: var(--steel); outline: none; box-shadow: 0 0 0 3px rgba(47,80,112,.15); }
  .field textarea { resize: vertical; }
  .field input[type="file"] { padding: .5em; background: var(--paper); cursor: pointer; }
  .hint { color: var(--muted); font-size: .82rem; }
  .hp { position: absolute !important; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .qform__actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .qform__status { margin: 0; font-weight: 600; font-size: .95rem; }
  .qform__status.ok { color: #117a3d; }
  .qform__status.err { color: #b4232a; }
  @media (max-width: 560px) { .qform__grid { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  form?.addEventListener('submit', async (e) => {
    if (!status) return;
    // Honeypot — silently drop bot submissions.
    if ((form.querySelector('.hp') as HTMLInputElement)?.checked) { e.preventDefault(); return; }

    const key = (form.querySelector('[name="access_key"]') as HTMLInputElement)?.value || '';
    // If the access key hasn't been configured, let the native POST proceed so the
    // owner notices during setup rather than failing silently via fetch.
    if (key.startsWith('REPLACE_WITH')) {
      status.textContent = '⚠ Form not yet configured — add your formly.email access key (see README).';
      status.className = 'qform__status err';
      e.preventDefault();
      return;
    }

    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    status.textContent = 'Sending…';
    status.className = 'qform__status';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      if (res.ok) {
        form.reset();
        status.textContent = '✓ Thank you — your enquiry has been sent. We will get back to you shortly.';
        status.className = 'qform__status ok';
      } else {
        throw new Error('bad response');
      }
    } catch {
      status.textContent = '✗ Something went wrong. Please email dhengineering121@gmail.com or call us.';
      status.className = 'qform__status err';
    } finally {
      btn.disabled = false;
    }
  });
</script>
