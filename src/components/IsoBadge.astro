---
interface Props { size?: number; class?: string; }
const { size = 86, class: cls = '' } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 100 100" role="img"
     aria-label="ISO 9001:2015 Certified Company">
  <circle cx="50" cy="50" r="48" fill="#0f2238" />
  <circle cx="50" cy="50" r="48" fill="none" stroke="#f5891f" stroke-width="2" />
  <circle cx="50" cy="50" r="33" fill="none" stroke="#ffffff" stroke-width="1.2" opacity="0.6" />
  <defs>
    <path id="iso-top" d="M 50,50 m -38,0 a 38,38 0 0 1 76,0" fill="none" />
    <path id="iso-bot" d="M 16,55 a 36,36 0 0 0 68,0" fill="none" />
  </defs>
  <text fill="#ffffff" font-family="Space Grotesk, sans-serif" font-size="9" font-weight="600" letter-spacing="2">
    <textPath href="#iso-top" startOffset="50%" text-anchor="middle">CERTIFIED</textPath>
  </text>
  <text fill="#ffffff" font-family="Space Grotesk, sans-serif" font-size="8.5" font-weight="600" letter-spacing="2">
    <textPath href="#iso-bot" startOffset="50%" text-anchor="middle">COMPANY</textPath>
  </text>
  <text x="50" y="47" text-anchor="middle" fill="#ffffff" font-family="Space Grotesk, sans-serif" font-size="18" font-weight="700">ISO</text>
  <text x="50" y="62" text-anchor="middle" fill="#f5891f" font-family="Space Grotesk, sans-serif" font-size="10" font-weight="600">9001:2015</text>
</svg>
