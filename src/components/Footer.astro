---
import Logo from './Logo.astro';
import { nav, company, iso } from '@/data/site';
const year = new Date().getFullYear();
const waHref = `https://wa.me/${company.whatsapp.number}?text=${encodeURIComponent(company.whatsapp.prefill)}`;
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo variant="light" />
      <p class="footer-tag">{company.legalTagline}</p>
      <p class="footer-cert">{iso.standard} Certified · Certificate No. {iso.certNo}</p>
    </div>

    <nav class="footer-col" aria-label="Footer">
      <h4>Company</h4>
      <ul>
        {nav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
        <li><a href="/downloads/">Downloads</a></li>
      </ul>
    </nav>

    <div class="footer-col">
      <h4>Contact</h4>
      <address>
        <p>{company.address.line1},<br />{company.address.line2},<br />{company.address.city} - {company.address.postalCode}, {company.address.state}</p>
        {company.contacts.map((c) => (
          <p><a href={`tel:${c.tel}`}>{c.name}: {c.phone}</a></p>
        ))}
        <p><a href={`mailto:${company.email}`}>{company.email}</a></p>
        <p class="footer-gst">GST: {company.gst}</p>
      </address>
      <a class="btn btn--whatsapp mt-1" href={waHref} target="_blank" rel="noopener">Chat on WhatsApp</a>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom__inner">
      <p>© {year} {company.name}. All rights reserved.</p>
      <p>Aluminium Die-Casting &amp; Machining · Kagal Five Star MIDC, Kolhapur, Maharashtra</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink-900); color: var(--on-dark-muted); }
  .footer-grid {
    display: grid; gap: 2.2rem; padding-block: 3.4rem 2.4rem;
    grid-template-columns: 1.5fr 1fr 1.4fr;
  }
  .footer-tag { color: var(--on-dark); margin-top: 1rem; max-width: 30ch; }
  .footer-cert { color: var(--accent); font-size: .9rem; font-family: var(--font-head); font-weight: 600; margin-top: .8rem; }
  .footer-col h4 { color: #fff; font-size: 1rem; margin-bottom: 1rem; letter-spacing: .03em; }
  .footer-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .55rem; }
  .footer-col a:not(.btn) { color: var(--on-dark-muted); }
  .footer-col a:not(.btn):hover { color: #fff; }
  address { font-style: normal; line-height: 1.55; }
  address p { margin-bottom: .55rem; color: var(--on-dark-muted); }
  .footer-gst { font-size: .85rem; opacity: .8; }
  .footer-bottom { border-top: 1px solid rgba(255,255,255,.1); }
  .footer-bottom__inner {
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    padding-block: 1.3rem; font-size: .85rem;
  }
  @media (max-width: 820px) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-brand { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
