---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import SpecTable from '@/components/SpecTable.astro';
import CTASection from '@/components/CTASection.astro';
import IsoBadge from '@/components/IsoBadge.astro';
import { iso, qualityInstruments } from '@/data/site';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Quality', href: '/quality/' }];
const certRows: [string, string][] = [
  ['Standard', iso.fullStandard],
  ['Certificate No.', iso.certNo],
  ['Scope', iso.scope],
  ['Issued By', iso.issuedBy],
  ['Initial Registration / Certificate Date', iso.initialDate],
  ['Surveillance Audit Due', iso.surveillanceDue],
  ['Recertification Due', iso.recertDue],
];
---
<BaseLayout
  title="Quality Assurance & ISO 9001:2015 Certification | DH Engineering"
  description="DH Engineering is ISO 9001:2015 certified (Cert. No. 09115077A). Quality is checked at every stage with calibrated in-house metrology — Mitutoyo & Baker instruments."
  breadcrumbs={crumbs}
>
  <PageHeader
    eyebrow="Quality Assurance"
    title="Quality checked at every stage — melt to final inspection"
    subtitle="Using calibrated, in-house metrology equipment for dimensional accuracy on every batch."
    current="/quality/"
  />

  <!-- ISO -->
  <section class="section">
    <div class="container">
      <div class="iso-grid">
        <div class="iso-badge-col">
          <IsoBadge size={150} />
          <p class="muted mt-2" style="font-size:.9rem">Certified by {iso.issuedBy}</p>
        </div>
        <div>
          <span class="eyebrow">Certification</span>
          <h2>ISO 9001:2015 Quality Management System</h2>
          <p class="mt-2">
            Our quality management system is independently certified to {iso.standard}, covering
            the {iso.scope.toLowerCase()}. Certification ensures consistent, standardised
            processes from casting through to final inspection.
          </p>
          <div class="mt-3">
            <SpecTable rows={certRows} />
          </div>
          <p class="muted mt-2" style="font-size:.88rem">
            A copy of the certificate is available on request — see the
            <a href="/downloads/">Downloads</a> page.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- INSTRUMENTS -->
  <section class="section section--paper">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">In-house metrology</span>
        <h2>Calibrated quality instruments</h2>
        <p class="lead">
          Dimensional inspection is carried out in-house using Mitutoyo, Baker and Luthra
          instruments — keeping measurement close to production for fast feedback and
          consistent results.
        </p>
      </div>
      <SpecTable head={qualityInstruments.head} rows={qualityInstruments.rows} />
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Our quality approach</span>
        <h2>Consistency built into the process</h2>
      </div>
      <div class="grid grid-3">
        <div class="card card--feature">
          <h3>Stable melt &amp; casting</h3>
          <p>A dedicated electric holding furnace and ladle-fed HPDC cell keep melt quality and casting cycles repeatable.</p>
        </div>
        <div class="card card--feature">
          <h3>In-process inspection</h3>
          <p>Calibrated vernier calipers, micrometers, dial and bore gauges verify critical dimensions on every batch.</p>
        </div>
        <div class="card card--feature">
          <h3>Tool life management</h3>
          <p>In-house CNC tool resharpening maintains cutting-tool geometry, protecting machined-feature accuracy.</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .iso-grid { display: grid; grid-template-columns: 200px 1fr; gap: clamp(1.6rem, 4vw, 3rem); align-items: start; }
  .iso-badge-col { text-align: center; position: sticky; top: calc(var(--header-h) + 16px); }
  @media (max-width: 760px) {
    .iso-grid { grid-template-columns: 1fr; }
    .iso-badge-col { position: static; }
  }
</style>
