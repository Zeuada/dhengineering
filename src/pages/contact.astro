---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ContactForm from '@/components/ContactForm.astro';
import MapEmbed from '@/components/MapEmbed.astro';
import { company } from '@/data/site';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact/' }];
const waHref = `https://wa.me/${company.whatsapp.number}?text=${encodeURIComponent(company.whatsapp.prefill)}`;
---
<BaseLayout
  title="Contact DH Engineering — Get a Quote | Kagal MIDC, Kolhapur"
  description="Contact DH Engineering for aluminium die-casting & machining. A-121 Five Star MIDC, Kagal, Kolhapur 416236. Send your drawing for a feasibility check and quote, or chat on WhatsApp."
  breadcrumbs={crumbs}
>
  <PageHeader
    eyebrow="Contact Us"
    title="Send us your drawing or requirement"
    subtitle="We'll get back to you with feasibility and a quote. Prefer to talk? Call or message us on WhatsApp."
    current="/contact/"
  />

  <section class="section">
    <div class="container contact-grid">
      <!-- FORM -->
      <div>
        <span class="eyebrow">Request a quote</span>
        <h2>Tell us about your component</h2>
        <p class="muted mt-1">Fields marked * are required. Attach a drawing if you have one.</p>
        <div class="mt-3"><ContactForm /></div>
      </div>

      <!-- DETAILS -->
      <aside class="contact-aside">
        <div class="card">
          <h3>Plant &amp; Office</h3>
          <address class="contact-address">
            <p>{company.address.line1},<br />{company.address.line2},<br />{company.address.city} - {company.address.postalCode}, {company.address.state}, {company.address.country}</p>
          </address>

          <h3 class="mt-3">Call us</h3>
          {company.contacts.map((c) => (
            <p class="contact-line"><a href={`tel:${c.tel}`}>{c.name} — {c.phone}</a></p>
          ))}

          <h3 class="mt-3">Email</h3>
          <p class="contact-line"><a href={`mailto:${company.email}`}>{company.email}</a></p>

          <h3 class="mt-3">GST</h3>
          <p class="contact-line">{company.gst}</p>

          <a class="btn btn--whatsapp mt-3" href={waHref} target="_blank" rel="noopener" style="width:100%">
            Chat on WhatsApp
          </a>
        </div>
      </aside>
    </div>
  </section>

  <!-- MAP -->
  <section class="section section--paper section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Find us</span>
        <h2>Kagal Five Star MIDC, Kolhapur</h2>
      </div>
      <MapEmbed />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid { display: grid; grid-template-columns: 1.4fr .9fr; gap: clamp(1.6rem, 4vw, 3rem); align-items: start; }
  .contact-aside .card { position: sticky; top: calc(var(--header-h) + 16px); }
  .contact-address p { color: var(--muted); line-height: 1.6; }
  .contact-line { margin-top: .2rem; }
  .contact-aside h3 { font-size: 1.02rem; }
  @media (max-width: 820px) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-aside .card { position: static; }
  }
</style>

<script>
  // Prefill the message when arriving from a product "Request a quote for this part" link.
  const params = new URLSearchParams(location.search);
  const part = params.get('part');
  if (part) {
    const ta = document.getElementById('f-message') as HTMLTextAreaElement | null;
    const label = part.replace(/-/g, ' ');
    if (ta && !ta.value) ta.value = `I'd like a quote for: ${label}.\n\nQuantity:\nMaterial / grade:\nTarget tolerances:\n`;
  }
</script>
